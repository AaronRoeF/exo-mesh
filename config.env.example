# exo-mail configuration — copy to config.env (this directory) or to
# ~/.config/exo-mail/config.env, then edit. NEVER commit the copy: it names
# directories on your machine, and `config.env` is in .gitignore for that reason.
#
# YOU PROBABLY NEED NONE OF THIS. Everything below has a working default, and
# your identity (addresses, name, mail root) is read from `notmuch config`,
# which you set up when you installed notmuch. Start with no config file at all;
# add a line only when you want to change something.
#
# Precedence, highest first:  environment variable  >  this file  >  default.
# Format: KEY=value, `#` comments, $HOME and ~ expand. It is also valid shell,
# so exo-mail-sync.sh sources the same file.
#
# Run `bin/exo-mail-python bin/exomail_config.py` at any time to print exactly
# what every setting resolved to.

# ---------------------------------------------------------------- locations
# Runtime dir: the venv, the sync log.            default ~/.local/share/exo-mail
#EXO_MAIL_HOME=$HOME/.local/share/exo-mail
# Maildir root, one directory per account.        default: notmuch database.mail_root
#EXO_MAIL_ROOT=$HOME/Mail
# Where exo-mail keeps its own databases.         default $EXO_MAIL_ROOT/exo
#EXO_MAIL_STORE=$HOME/Mail/exo
# OAuth client secrets and tokens.                default ~/.config/exo-mail
#EXO_MAIL_CONFIG_DIR=$HOME/.config/exo-mail
# Scratch dir for tools that write reports.       default $EXO_MAIL_STORE/work
#EXO_MAIL_WORKDIR=$HOME/Documents/exo-mail
# notmuch binary.                                 default: first one found
#EXO_NOTMUCH=/opt/homebrew/bin/notmuch
# Python interpreter for every tool.              default: ../venv/bin/python
#EXO_MAIL_PYTHON=/opt/exo-mail/venv/bin/python

# ---------------------------------------------------------------- accounts
# Ordered account names. Each must match a directory under EXO_MAIL_ROOT and a
# lieer checkout inside it.                       default work,personal
#EXO_MAIL_ACCOUNTS=work,personal
# Per-account From: address. Only needed if notmuch's user.primary_email /
# user.other_email do not already list them in this order.
#EXO_MAIL_EMAIL_WORK=jordan@acmerobotics.example.com
#EXO_MAIL_EMAIL_PERSONAL=jordan.rivera@example.com
# Extra addresses that are also you (old domains, aliases), comma separated.
#EXO_MAIL_SELF_EMAILS=j.rivera@example.org
# Per-account Gmail pull query. The unsuffixed EXO_GMI_QUERY sets the default
# for every account.   default: -in:chats -in:spam -in:trash -larger:250K
#EXO_GMI_QUERY_PERSONAL=(label:^smartlabel_personal OR from:me) -in:chats -in:spam -in:trash -larger:250K

# ---------------------------------------------------------------- identity
# Your name, used for the review banner on drafts.  default: notmuch user.name
#EXO_MAIL_OWNER=Jordan Rivera
# How you sign mail.               default: ~ plus your lower-case initials (~jr)
#EXO_MAIL_SIGNOFF=~jr

# ---------------------------------------------------------------- optional
# A markdown notes directory. Enables the journal line in `exo-day`, and, via
# EXO_MAIL_PEOPLE, person-file enrichment in the mesh. Unset = both are skipped.
#EXO_MAIL_NOTES=$HOME/Notes
# One markdown file per person, named <first-last>.md, with the person's own
# addresses in the YAML frontmatter.             default $EXO_MAIL_NOTES/people
#EXO_MAIL_PEOPLE=$HOME/Notes/people
# Where exo-mesh-bedrock-apply reads its confirmed list.
#EXO_MAIL_BEDROCK_STAGE=$HOME/Notes/bedrock-confirmed.tsv
# Where exo-mail-archdoc writes the generated architecture section.
#EXO_MAIL_ARCHDOC_OUT=$HOME/Notes/exo-mail-architecture.md
# Copy hand-authored rule files here on every sync. Unset = step skipped.
#EXO_MAIL_STATE_BACKUP=$HOME/Notes/exo-mail-state
# exo/* namespaces kept in sync with Gmail labels.
#EXO_MAIL_BUCKETS=vip,feed,fins,updates,paper-trail,needs-reply,reply-later
# Soft cap, in MB, on the whole mail tree. Over it the sync log gets a ranked
# list of ways to reclaim space. It never deletes anything.
#EXO_MAIL_STORAGE_CAP_MB=14336
# The scheduler label your sync runs under. `exo-mail doctor` checks it is
# loaded; unset, that check is skipped rather than reported as a failure.
#EXO_MAIL_SYNC_JOB=com.example.exo-mail-sync
# A page `exo-mesh caps` points at. Unset = the line is omitted.
#EXO_MAIL_CAPS_URL=http://localhost:8787/exo-capabilities/
# Where the sync writes its log.                 default $EXO_MAIL_HOME/sync.log
#EXO_MAIL_SYNC_LOG=$HOME/Library/Logs/exo-mail-sync.log

# Where a tool drops a note when it decided something on its own (a drift
# suppression, say). Unset = <workdir>/observations.
#EXO_MAIL_OBS="$HOME/notes/observations"

# A dedicated calendar for context entries the tool writes for YOU to read.
# Create it by hand in your calendar UI first: the calendar.events scope deliberately
# cannot create or delete a calendar, only put events on one that already exists.
# Then paste its calendar ID here. Unset = context entries are skipped entirely.
#EXO_CAL_CONTEXT_ID="xxxxxxxx@group.calendar.google.com"
