#!/bin/sh
''''exec "${0%/*}/exo-mail-python" "$0" "$@" # '''
"""exo-mesh — front door to the mesh: the local-first join over your mail,
contacts, calendar, and todos. Bare `exo-mesh` shows your day; `exo-mesh caps`
lists what you can do. A thin launcher over the underlying tools — it renames
nothing, it's just the memorable entry point.

Known subcommands: since, conversation, relationship, prep, caps. Anything else
that isn't an option (doesn't start with `-`) is a usage error — it used to
fall through to `exo-day` in silence, which hid typos as a day brief instead
of naming them.
"""
import sys, os, subprocess
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import exomail_config as CFG

BIN = os.path.dirname(os.path.abspath(__file__))
a = sys.argv[1:]

SUBCOMMANDS = ("since", "conversation", "relationship", "prep", "caps")

# `since` is the mesh's own subcommand — the deterministic window every enrichment pass
# was re-deriving by hand. Dispatched, not reimplemented: the launcher stays a launcher.
if a and a[0] == "since":
    sys.exit(subprocess.run([os.path.join(BIN, "exo-mesh-since"), *a[1:]]).returncode)

# `conversation` and `relationship` are the person-foundation analysis commands: one
# person's cross-channel timeline, and that relationship's dynamics. Dispatched exactly
# like `since` — the launcher stays a launcher.
if a and a[0] == "conversation":
    sys.exit(subprocess.run([os.path.join(BIN, "exo-mesh-conversation"), *a[1:]]).returncode)

if a and a[0] == "relationship":
    sys.exit(subprocess.run([os.path.join(BIN, "exo-mesh-relationship"), *a[1:]]).returncode)

# `prep` is the meeting brief: one event, every attendee's relationship on every channel, as of
# the meeting's start. Dispatched exactly like `since` — the launcher stays a launcher.
if a and a[0] == "prep":
    sys.exit(subprocess.run([os.path.join(BIN, "exo-mesh-prep"), *a[1:]]).returncode)

if a and a[0] in ("caps", "capabilities", "help", "-h", "--help"):
    print("exo-mesh — one mesh over mail · contacts · calendar · todos\n")
    print("  exo-mesh                     your whole day, one local read (= exo-day)")
    print("  exo-mesh since --since 7d    what changed in your relationships in a window")
    print("  exo-mesh conversation <person>   one person's mail + texts, one timeline")
    print("  exo-mesh relationship <person>   one relationship's dynamics: streaks, gaps, initiation")
    print("  exo-mesh prep <meeting-id>    one meeting's brief: who's coming, standing, one action")
    print("  exo-mail brief               the reply queue + drifting relationships")
    print("  exo-mail box imbox           real correspondence, newsletters filtered")
    print("  exo-mail contact show <name> one whole person across all addresses")
    print("  exo-mail reconnect \"<name>\"   warm re-connect for a drifted relationship")
    print("  exo-mail bedrock candidates  enduring relationships (outlived their context)")
    print("  exo-mail search|semantic ..  keyword or meaning search, offline")
    print("  exo-cal stats                local calendar replica (3 sources)")
    print("  exo-mail-filter add <s> <b>  pin a sender to a bucket, permanently")
    _caps = CFG.caps_url()
    if _caps:
        print("\n  full reminder: %s" % _caps)
    sys.exit(0)

# bare `exo-mesh`, or a first argument that is an option (e.g. exo-day's own flags),
# still goes to the unified day.
if not a or a[0].startswith("-"):
    sys.exit(subprocess.run([os.path.join(BIN, "exo-day"), *a]).returncode)

# Any other first word names no subcommand this front door knows. Exit with the usage
# code, print nothing on stdout, and name the word on stderr (spec: "The front door
# rejects an unknown subcommand").
sys.stderr.write("exo-mesh: unknown subcommand %r — try: %s\n" % (a[0], ", ".join(SUBCOMMANDS)))
sys.exit(1)
